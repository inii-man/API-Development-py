{
  "info": {
    "_postman_id": "taskhub-day1-collection",
    "name": "TaskHub API - Hari 1 Lab Collection",
    "description": "Koleksi request dan pengujian otomatis untuk API Development Training Hari 1: Desain REST, OpenAPI, dan Autentikasi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Status is pass', function () { var jsonData = pm.response.json(); pm.expect(jsonData.status).to.eql('pass'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01. Login Alice (Member Tim A)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"Lab-Only-123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login Alice berhasil (200)', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Menerima Bearer token', function () { pm.expect(jsonData.token).to.be.a('string'); });",
              "pm.environment.set('aliceToken', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Create Task (Alice)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implementasi Kontrak REST TaskHub\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Header Location tersedia', function () { pm.response.to.have.header('Location'); });",
              "var jsonData = pm.response.json();",
              "pm.environment.set('taskId', jsonData.data.id);",
              "pm.environment.set('taskVersion', jsonData.data.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "03. List Tasks (Alice)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks?page=1&pageSize=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "20" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Response berisi data array dan metadata', function () {",
              "  pm.expect(jsonData.data).to.be.an('array');",
              "  pm.expect(jsonData.meta.page).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Detail Task Sendiri (Alice)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.expect(jsonData.data.id).to.eql(pm.environment.get('taskId'));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. PATCH Task Versi 1 (Alice)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"done\",\n  \"version\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test('Version meningkat menjadi 2', function () { pm.expect(jsonData.data.version).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06. PATCH Task Versi Lama (Konflik 409)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"open\",\n  \"version\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409 Conflict', function () { pm.response.to.have.status(409); });",
              "var jsonData = pm.response.json();",
              "pm.test('Error code VERSION_CONFLICT', function () { pm.expect(jsonData.error.code).to.eql('VERSION_CONFLICT'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Login Bob (Member Tim B)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"bob\",\n  \"password\": \"Lab-Only-123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login Bob berhasil (200)', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.environment.set('bobToken', jsonData.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Uji BOLA - Bob Akses Task Alice (Ditolak 403)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{bobToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 403 Forbidden', function () { pm.response.to.have.status(403); });",
              "var jsonData = pm.response.json();",
              "pm.test('Error code FORBIDDEN', function () { pm.expect(jsonData.error.code).to.eql('FORBIDDEN'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Uji Mass Assignment - Kirim owner_id (Ditolak 422)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Coba Ubah Owner\",\n  \"owner_id\": \"u2\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422 Unprocessable Entity', function () { pm.response.to.have.status(422); });",
              "var jsonData = pm.response.json();",
              "pm.test('Error code INVALID_PAYLOAD', function () { pm.expect(jsonData.error.code).to.eql('INVALID_PAYLOAD'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. DELETE Task (Alice)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204 No Content', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Detail Task Setelah Dihapus (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{aliceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/tasks/{{taskId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "tasks", "{{taskId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404 Not Found', function () { pm.response.to.have.status(404); });",
              "var jsonData = pm.response.json();",
              "pm.test('Error code NOT_FOUND', function () { pm.expect(jsonData.error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ]
    }
  ]
}
